{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile --prefer-offline",
  "framework": "vite",
  "regions": ["iad1"],
  "env": {
    "VITE_APP_ID": "plataforma-obras",
    "PUBLIC_APP_URL": "https://plataforma-obras-8uhqy3k5f-rafael-5864.vercel.app"
  },
  "github": {
    "silentDeploys": true
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://plataforma-obras-production.up.railway.app/api/:path*"
    }
  ]
}
